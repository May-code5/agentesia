# Base de datos SQLite (ruta relativa a la carpeta prisma/)
DATABASE_URL="file:./dev.db"

# Secreto para sesión demo / cookies firmadas
DEMO_SECRET="cambia-este-secreto-en-produccion"
NEXTAUTH_SECRET="cambia-este-secreto-en-produccion"

# Opcional: habilita respuestas reales de IA en el widget y agentes
