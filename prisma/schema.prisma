generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  timezone     String         @default("America/Lima")
  businessName String?
  logoUrl      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  users        User[]
  agents       Agent[]
  conversations Conversation[]
  settings     WorkspaceSettings?
}

model WorkspaceSettings {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  openaiKeyHint   String?
  anthropicKeyHint String?
  whatsappTokenHint String?
  webhookSecret   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("admin")
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Agent {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  systemPrompt    String
  tone            String    @default("amigable")
  knowledgeMd     String    @default("")
  enabledChannels String    @default("WEB,WHATSAPP,INSTAGRAM,EMAIL,VOICE")
  handoffRules    String    @default("")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  conversations   Conversation[]
}

model Conversation {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId       String?
  agent         Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  channel       String
  status        String    @default("open")
  subject       String?
  contactName   String
  contactHandle String?
  assignedTo    String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body           String
  senderType     String
  senderName     String?
  metadata       String?
  createdAt      DateTime     @default(now())
}
